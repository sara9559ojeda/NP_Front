# Copy to .env.local and adjust. Never put secrets here: the web has none.

# Base path of the API. With the dev proxy, keep the relative path.
VITE_API_BASE_URL=/api/v1

# true: the simulated server (MSW) answers in the browser. false: real backend.
VITE_USE_MOCKS=true

# Where the dev server forwards /api when VITE_USE_MOCKS=false.
VITE_PROXY_TARGET=http://localhost:8000

# Solo en Vercel, variables DEL SERVIDOR (sin VITE_):
# NP_BACKEND_ORIGIN=https://URL-REAL-DEL-BACKEND
# NP_PROXY_SECRET=misma-clave-aleatoria-de-al-menos-32-caracteres-que-NP_Back
